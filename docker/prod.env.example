# Copy to docker/prod.env and fill in. Not committed: it holds the secrets.
#
# DB_NAME/DB_USER/DB_PASSWORD are also what sites/database/register-site reads to
# create the site's role and database on the shared PostgreSQL.

ENV=prod
# The site's directory name, which is also its domain and its alias on sites_proxy
COMPOSE_PROJECT_NAME=<site>

CONFIG_FILE=./docker/prod_django.ini

DB_NAME=<site>
DB_USER=<site>
DB_PASSWORD=
DB_HOST=postgres
DB_PORT=5432

SECRET_KEY=
DJANGO_PORT=8000

RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
