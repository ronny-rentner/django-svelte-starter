# Copy to docker/prod.env and fill in. Not committed: it holds the secrets.
#
# DB_NAME/DB_USER/DB_PASSWORD are also what sites/database/register-site reads to
# create the site's role and database on the shared PostgreSQL.

ENV=prod

# Main site name used for naming resources and accessing services, needs to be unique
COMPOSE_PROJECT_NAME=django-svelte-starter

CONFIG_FILE=./docker/prod_django.ini

DB_NAME=<site>
DB_USER=<site>
DB_PASSWORD=
DB_HOST=postgres
DB_PORT=5432

SECRET_KEY=
DJANGO_PORT=8000

RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
