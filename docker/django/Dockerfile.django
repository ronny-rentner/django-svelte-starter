FROM python:3.13-slim

# Don't set PYTHONUNBUFFERED, it slows Python down by 20-30%
ENV PYTHONPYCACHEPREFIX=/dev/shm/python

# git: four dependencies install from GitHub.
# netcat-traditional and postgresql-client: the entrypoint waits for PostgreSQL with
# `nc` and loads the initial dump with `psql`.
RUN apt-get -q update && apt-get install -qy \
    git \
    netcat-traditional \
    postgresql-client \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# The dependency list lives in backend/, so install from there before copying the
# rest: a frontend or cli change then reuses the installed layer.
COPY ./backend /app/backend

RUN pip install --no-cache-dir --upgrade pip
# Editable, so Django reads templates and static files from the copied source tree
RUN pip install --no-cache-dir -e ./backend

COPY . /app

RUN ls -la /app

# Expose the port the app runs on
EXPOSE ${DJANGO_PORT}

COPY ./docker/django/entrypoint.sh ./entrypoint.sh

ENTRYPOINT ["./entrypoint.sh"]
